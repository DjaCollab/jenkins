@NonCPS
def extractBuildNumber(String path) {
    def m = (path =~ /(\d+\.\d+\.\d+\.\d+)/)
    return m.find() ? m.group(1) : null
}

@NonCPS
def extractHotfix(String name) {
    // Hotfix releases are named "SOFTW-01275-04 - IBIS Database 6.0.0.107 HF1.4.exe".
    def m = (name =~ /\b(HF[\d.]+)/)
    return m.find() ? m.group(1) : null
}

@NonCPS
def classifyGroup(String name) {
    def upper = name.toUpperCase()
    if (upper.startsWith('SVR')) return 'CS'
    if (upper.startsWith('DCXA') || upper.startsWith('DCXB') || upper.startsWith('DCXC')) return 'LIR'
    if (upper.startsWith('DCX')) return 'DCX'
    return 'UNKNOWN'
}

@NonCPS
def compareBuildVersions(String a, String b) {
    // Numeric, dot-separated comparison (e.g. "6.0.0.9" < "6.0.0.10") - a plain string
    // compare would get that backwards.
    def as_ = a.tokenize('.').collect { it as int }
    def bs  = b.tokenize('.').collect { it as int }
    for (int i = 0; i < Math.max(as_.size(), bs.size()); i++) {
        def av = i < as_.size() ? as_[i] : 0
        def bv = i < bs.size() ? bs[i] : 0
        if (av != bv) return av <=> bv
    }
    return 0
}

@NonCPS
def extractMinSchemaVersion(String releaseNotesText) {
    // e.g. "...the IBIS database must be at version\n- 6.0.0.218 or later build"
    def m = (releaseNotesText =~ /(\d+\.\d+\.\d+\.\d+)\s+or later build/)
    return m.find() ? m.group(1) : null
}

@NonCPS
def jsonEscape(String s) {
    if (s == null) return ''
    return s.replace('\\', '\\\\').replace('"', '\\"').replace('\n', ' ').replace('\r', '')
}

@NonCPS
def extractPgVersion(String text) {
    def m = (text =~ /PostgreSQL (\d+\.\d+)/)
    return m.find() ? m.group(1) : null
}

@NonCPS
def extractPgTargetVersion(String releaseNotesText) {
    // The description reads e.g. "...upgrade of a PostgreSQL 14.17 database to PostgreSQL
    // 17.6" - the destination version is the one named after "to PostgreSQL", not the first
    // PostgreSQL version mentioned in the file.
    def toMatch = (releaseNotesText =~ /to PostgreSQL (\d+\.\d+)/)
    if (toMatch.find()) {
        return toMatch.group(1)
    }
    // Fall back to the last "PostgreSQL x.y" mention (e.g. a fresh-install release note with
    // no "upgrade ... to" wording).
    def all = (releaseNotesText =~ /PostgreSQL (\d+\.\d+)/)
    def last = null
    while (all.find()) {
        last = all.group(1)
    }
    return last
}

// These helper methods (below) are declared at the top level rather than inline in the
// pipeline's script{} blocks so that each one is CPS-transformed as its own JVM method -
// one giant script{} block over ~1000 lines hit "Method too large" (the 64KB per-method
// bytecode limit) once the report/Teams HTML and per-VM logic were all one method. They
// are deliberately NOT @NonCPS - they call pipeline steps (bat, echo, powershell, stage,
// writeFile, error, currentBuild), which requires the CPS interpreter. They read shared
// state via env (a plain Groovy local/closure from one script{} block isn't visible to a
// separate top-level method).

// Sent at most once per build, right when the first real install (PG or DB) actually
// starts - never for a DRY_RUN or a VM that turns out already up to date, since nothing
// real is happening in those cases.
def sendInProgressNotification(String hostName, boolean pgUpgradeAvailable) {
    if (env.UPGRADE_IN_PROGRESS_NOTIFIED == 'true') {
        return
    }
    env.UPGRADE_IN_PROGRESS_NOTIFIED = 'true'

    def pgTargetFactInProgress = pgUpgradeAvailable ? ",\n{\"title\": \"PG target version\", \"value\": \"${jsonEscape(env.PG_TARGET_VERSION)}\"}" : ''

    def inProgressCard = """{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "content": {
                "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                    {
                        "type": "TextBlock",
                        "text": "🔄 IBIS Upgrade in progress",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "warning"
                    },
                    {
                        "type": "TextBlock",
                        "text": "${jsonEscape(env.TRIGGER_CAUSE)} • started upgrading ${jsonEscape(hostName)}",
                        "isSubtle": true,
                        "wrap": true
                    },
                    {
                        "type": "FactSet",
                        "facts": [
                            {"title": "DB target build", "value": "${jsonEscape(env.INSTALLER_LABEL)}"}${pgTargetFactInProgress}
                        ]
                    }
                ],
                "actions": [
                    {
                        "type": "Action.OpenUrl",
                        "title": "View build",
                        "url": "${env.BUILD_URL}"
                    }
                ]
            }
        }
    ]
}"""

    writeFile file: 'teams_card_in_progress.json', text: inProgressCard, encoding: 'UTF-8'
    withCredentials([string(credentialsId: 'Teams-PGUP', variable: 'TEAMS_WEBHOOK_URL')]) {
        try {
            powershell '''
                try {
                    $response = Invoke-WebRequest -Uri $env:TEAMS_WEBHOOK_URL -Method Post -ContentType 'application/json' -InFile 'teams_card_in_progress.json' -UseBasicParsing
                    Write-Output "Teams webhook response: HTTP $($response.StatusCode) - $($response.Content)"
                } catch {
                    $statusCode = $null
                    $body = $null
                    if ($_.Exception.Response) {
                        $statusCode = [int]$_.Exception.Response.StatusCode
                        $stream = $_.Exception.Response.GetResponseStream()
                        if ($stream) {
                            $body = (New-Object System.IO.StreamReader($stream)).ReadToEnd()
                        }
                    }
                    Write-Output "Teams webhook error: HTTP $statusCode - $body"
                    throw
                }
            '''
            echo "Teams in-progress notification sent"
        } catch (Exception teamsEx) {
            echo "Failed to send Teams in-progress notification: ${teamsEx.getMessage()}"
        }
    }
}

def processVm(vm, group, pgUpgradeAvailable, detail) {
    def version = 'N/A'
    def status = 'Failed'

                                        stage("Process ${vm.name}") {
                                            env.DB_HOST = vm.name

                                            def connRc = bat(
                                                script: '''
                                                    set PGPASSWORD=%DB_PASSWORD%
                                                    psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -c "SELECT 1;"
                                                ''',
                                                returnStatus: true
                                            )
                                            detail << [label: 'Connection', passed: (connRc == 0), value: (connRc == 0) ? 'OK' : "psql exit ${connRc}"]

                                            if (connRc == 0 && pgUpgradeAvailable) {
                                                def pgVerRc = bat(
                                                    script: '''
                                                        set PGPASSWORD=%DB_PASSWORD%
                                                        psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "select version();" > pg_engine_version.txt
                                                    ''',
                                                    returnStatus: true
                                                )
                                                def pgEngineVersion = (pgVerRc == 0) ? extractPgVersion(readFile('pg_engine_version.txt').trim()) : null
                                                echo "PostgreSQL engine on ${vm.name}: ${pgEngineVersion ?: 'unknown'} (target ${env.PG_TARGET_VERSION})"

                                                if (!pgEngineVersion) {
                                                    detail << [label: 'PostgreSQL engine', passed: false, value: 'Could not read current version via select version()']
                                                    env.PG_UPGRADE_ABORTED = 'true'
                                                    env.PG_UPGRADE_ERROR = "Could not read PostgreSQL version on ${vm.name}"
                                                } else if (pgEngineVersion == env.PG_TARGET_VERSION) {
                                                    detail << [label: 'PostgreSQL engine', passed: true, value: "${pgEngineVersion} (up to date)"]
                                                } else if (params.DRY_RUN) {
                                                    echo "DRY_RUN: PostgreSQL engine on ${vm.name} is ${pgEngineVersion}, target is ${env.PG_TARGET_VERSION} - upgrade skipped"
                                                    detail << [label: 'PostgreSQL engine', passed: null, value: "Skipped - DRY_RUN (${pgEngineVersion} -> ${env.PG_TARGET_VERSION} needed)"]
                                                } else {
                                                    def currentMajor = pgEngineVersion.tokenize('.')[0]
                                                    // 14 -> 17 is a major upgrade; 17.x -> 17.y within the same major is a minor one.
                                                    def pgInstallType = (currentMajor != env.PG_TARGET_MAJOR) ? 'PGupgrade' : 'PGminor'
                                                    echo "PostgreSQL engine on ${vm.name} is ${pgEngineVersion}, target is ${env.PG_TARGET_VERSION} - running /InstallType=${pgInstallType}"
                                                    sendInProgressNotification(vm.name, pgUpgradeAvailable)

                                                    try {
                                                        def pgInstallOutput
                                                        withEnv(["TARGET_HOST=${vm.name}", "PG_INSTALL_TYPE=${pgInstallType}", "LOCAL_PG_LOG=pg-install-${vm.name}.log"]) {
                                                            pgInstallOutput = powershell(returnStdout: true, script: '''
                                                                $securePassword = ConvertTo-SecureString $env:DB_PASSWORD -AsPlainText -Force
                                                                $credential = New-Object System.Management.Automation.PSCredential("$env:DB_DOMAIN\\$env:DB_USER", $securePassword)
                                                                $session = New-PSSession -ComputerName $env:TARGET_HOST -Credential $credential

                                                                $remoteDir = "C:\\Temp"
                                                                $exeName = Split-Path $env:PG_EXE_PATH -Leaf
                                                                # A leftover, still-locked file from a prior stuck/hung install must never block a
                                                                # new attempt from copying - so the remote name is unique per Jenkins build.
                                                                $exeBase = [System.IO.Path]::GetFileNameWithoutExtension($exeName)
                                                                $exeExt = [System.IO.Path]::GetExtension($exeName)
                                                                $remotePath = Join-Path $remoteDir "$exeBase-build$env:BUILD_NUMBER$exeExt"
                                                                $remoteLog = Join-Path $remoteDir "pg-install-$env:PG_INSTALL_TYPE.log"

                                                                Invoke-Command -Session $session -ScriptBlock {
                                                                    param($dir)
                                                                    New-Item -ItemType Directory -Force -Path $dir | Out-Null
                                                                } -ArgumentList $remoteDir

                                                                Copy-Item -Path $env:PG_EXE_PATH -Destination $remotePath -ToSession $session

                                                                $exitCode = Invoke-Command -Session $session -ScriptBlock {
                                                                    param($path, $log, $installType)
                                                                    $installArgs = @(
                                                                        "/VerySilent",
                                                                        "/SUPPRESSMSGBOXES",
                                                                        "/NORESTART",
                                                                        "/LOG=$log",
                                                                        "/InstallType=$installType"
                                                                    )
                                                                    $p = Start-Process -FilePath $path -ArgumentList $installArgs -PassThru
                                                                    # WinRM runs this in session 0 with no desktop. A silent installer that
                                                                    # still pops a dialog would otherwise wait forever with no output.
                                                                    if (-not $p.WaitForExit(90 * 60 * 1000)) {
                                                                        $p.Kill()
                                                                        return 8002
                                                                    }
                                                                    return $p.ExitCode
                                                                } -ArgumentList $remotePath, $remoteLog, $env:PG_INSTALL_TYPE

                                                                try {
                                                                    Copy-Item -Path $remoteLog -Destination $env:LOCAL_PG_LOG -FromSession $session -ErrorAction Stop
                                                                } catch {
                                                                    Write-Output "LOGCOPY:failed - $($_.Exception.Message)"
                                                                }

                                                                Remove-PSSession $session

                                                                Write-Output "EXITCODE:$exitCode"
                                                            '''.trim())
                                                        }
                                                        echo pgInstallOutput
                                                        def pgExitLine = pgInstallOutput.readLines().find { it.startsWith('EXITCODE:') }
                                                        def pgExitCode = pgExitLine ? pgExitLine.replace('EXITCODE:', '').trim() : 'unknown'

                                                        // Inno Setup: 0 = done, 3010 = done but the machine wants a reboot. 8002 is ours, set above.
                                                        if (pgExitCode == '0' || pgExitCode == '3010') {
                                                            // Trust the database, not the exit code.
                                                            def pgVerifyRc = bat(
                                                                script: '''
                                                                    set PGPASSWORD=%DB_PASSWORD%
                                                                    psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "select version();" > pg_engine_version_post.txt
                                                                ''',
                                                                returnStatus: true
                                                            )
                                                            def postPgVersion = (pgVerifyRc == 0) ? extractPgVersion(readFile('pg_engine_version_post.txt').trim()) : null

                                                            if (postPgVersion == env.PG_TARGET_VERSION) {
                                                                detail << [label: 'PostgreSQL engine', passed: true, value: "upgraded ${pgEngineVersion} -> ${postPgVersion}${pgExitCode == '3010' ? ' (reboot pending)' : ''}"]
                                                            } else {
                                                                detail << [label: 'PostgreSQL engine', passed: false, value: "exit ${pgExitCode} but database reports ${postPgVersion ?: 'unknown'}, expected ${env.PG_TARGET_VERSION}"]
                                                                env.PG_UPGRADE_ABORTED = 'true'
                                                                env.PG_UPGRADE_ERROR = "PostgreSQL upgrade on ${vm.name} reported exit ${pgExitCode} but engine is still ${postPgVersion ?: 'unknown'}"
                                                            }
                                                        } else {
                                                            detail << [label: 'PostgreSQL engine', passed: false, value: "installer exit code ${pgExitCode}"]
                                                            env.PG_UPGRADE_ABORTED = 'true'
                                                            env.PG_UPGRADE_ERROR = "PostgreSQL installer on ${vm.name} exited ${pgExitCode}"
                                                        }
                                                    } catch (Exception pgEx) {
                                                        detail << [label: 'PostgreSQL engine', passed: false, value: "remoting error: ${pgEx.getMessage()}"]
                                                        env.PG_UPGRADE_ABORTED = 'true'
                                                        env.PG_UPGRADE_ERROR = "PostgreSQL upgrade remoting error on ${vm.name}: ${pgEx.getMessage()}"
                                                    }
                                                }
                                            }

                                            if (connRc == 0) {
                                                def checkconRc = bat(
                                                    script: '''
                                                        set PGPASSWORD=%DB_PASSWORD%
                                                        psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT checkcon();" > checkcon_output.txt
                                                    ''',
                                                    returnStatus: true
                                                )
                                                if (checkconRc == 0) {
                                                    env.CHECKCON_OUTPUT = readFile('checkcon_output.txt').trim()
                                                    echo env.CHECKCON_OUTPUT
                                                    env.CHECKCON_PASSED = (
                                                        env.CHECKCON_OUTPUT.contains('0 disabled trigger found') &&
                                                        env.CHECKCON_OUTPUT.contains('0 disabled constraint(s) found') &&
                                                        env.CHECKCON_OUTPUT.contains('materialized view(s) refreshed') &&
                                                        env.CHECKCON_OUTPUT.contains('Images and signatures partition definitions are compliant.') &&
                                                        env.CHECKCON_OUTPUT.contains('Table scan_partitions is compliant.')
                                                    ) as String
                                                } else {
                                                    env.CHECKCON_OUTPUT = ''
                                                    env.CHECKCON_PASSED = 'false'
                                                }
                                                detail << [label: 'Consistency (checkcon)', passed: (env.CHECKCON_PASSED == 'true'), value: env.CHECKCON_PASSED == 'true' ? 'compliant' : 'issues found']

                                                // Reported for visibility only - no longer gates the install. An installer
                                                // that cannot take an exclusive lock can still half-apply, which leaves the
                                                // database worse off than refusing to start; ignoring this is a deliberate,
                                                // explicit choice, not an oversight.
                                                def connCountRc = bat(
                                                    script: '''
                                                        set PGPASSWORD=%DB_PASSWORD%
                                                        psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT count(*) FROM pg_stat_activity WHERE datname='ibis' AND pid<>pg_backend_pid();" > active_conns.txt
                                                    ''',
                                                    returnStatus: true
                                                )
                                                def activeConns = (connCountRc == 0) ? (readFile('active_conns.txt').trim() as Integer) : -1
                                                echo "Active connections on ${vm.name} (excluding this one): ${activeConns}"
                                                detail << [label: 'Active connections', passed: null, value: (activeConns < 0) ? 'could not be read' : "${activeConns}"]

                                                def pgVerRc = bat(
                                                    script: '''
                                                        set PGPASSWORD=%DB_PASSWORD%
                                                        psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT version();" > pg_version_output.txt
                                                    ''',
                                                    returnStatus: true
                                                )
                                                if (pgVerRc == 0) {
                                                    env.PG_VERSION_OUTPUT = readFile('pg_version_output.txt').trim()
                                                    echo env.PG_VERSION_OUTPUT
                                                    env.PG_VERSION_MATCHED = env.PG_VERSION_OUTPUT.contains(env.PG_VERSION_EXPECTED) as String
                                                } else {
                                                    env.PG_VERSION_OUTPUT = ''
                                                    env.PG_VERSION_MATCHED = 'false'
                                                }
                                                detail << [label: "PostgreSQL ${env.PG_VERSION_EXPECTED}", passed: (env.PG_VERSION_MATCHED == 'true'), value: env.PG_VERSION_OUTPUT ?: 'unknown']

                                                def vmTypeRc = bat(
                                                    script: '''
                                                        set PGPASSWORD=%DB_PASSWORD%
                                                        psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT sit_cod FROM sys_params;" > sitcod_output.txt
                                                    ''',
                                                    returnStatus: true
                                                )
                                                def vmTypeValid = false
                                                def sitCod = ''
                                                if (vmTypeRc == 0) {
                                                    sitCod = readFile('sitcod_output.txt').trim()
                                                    echo "sit_cod: ${sitCod}"

                                                    def hostUpper = env.DB_HOST.toUpperCase()
                                                    def vmType = hostUpper.startsWith('DCX') ? 'DCX' : hostUpper.startsWith('SVR') ? 'CS' : 'UNKNOWN'
                                                    def expectedDigit = (vmType == 'DCX') ? '2' : (vmType == 'CS') ? '9' : null
                                                    def fourthDigit = (sitCod?.length() >= 4) ? sitCod[3] : null
                                                    vmTypeValid = (expectedDigit != null && fourthDigit == expectedDigit)
                                                    echo "VM type: ${vmType}, expected 4th digit of sit_cod: ${expectedDigit}, actual: ${fourthDigit}, valid: ${vmTypeValid}"
                                                }
                                                env.VM_TYPE_VALID = vmTypeValid as String
                                                detail << [label: 'VM type (sit_cod)', passed: vmTypeValid, value: sitCod ?: 'unknown']

                                                if (group == 'LIR') {
                                                    def siteRc = bat(
                                                        script: '''
                                                            set PGPASSWORD=%DB_PASSWORD%
                                                            psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT typ FROM sites WHERE cod=(SELECT sit_cod FROM sys_params);" > site_type_output.txt
                                                        ''',
                                                        returnStatus: true
                                                    )
                                                    def siteType = ''
                                                    if (siteRc == 0) {
                                                        siteType = readFile('site_type_output.txt').trim()
                                                    }
                                                    env.SITE_TYPE_VALID = (siteType == 'LIR') as String
                                                    echo "site type: ${siteType}, valid LIR: ${env.SITE_TYPE_VALID}"
                                                    detail << [label: 'Site type (LIR)', passed: (env.SITE_TYPE_VALID == 'true'), value: siteType ?: 'unknown']
                                                } else {
                                                    env.SITE_TYPE_VALID = 'true'
                                                }

                                                def buildRc = bat(
                                                    script: '''
                                                        set PGPASSWORD=%DB_PASSWORD%
                                                        psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT last_pkg_update();" > last_pkg_update_output.txt
                                                    ''',
                                                    returnStatus: true
                                                )
                                                if (buildRc == 0) {
                                                    env.LAST_PKG_UPDATE_OUTPUT = readFile('last_pkg_update_output.txt').trim()
                                                    echo env.LAST_PKG_UPDATE_OUTPUT
                                                    env.CURRENT_BUILD = extractBuildNumber(env.LAST_PKG_UPDATE_OUTPUT)
                                                } else {
                                                    // last_pkg_update() doesn't exist on older schemas - not a failure, fall back
                                                    // to the most recent build recorded in ibis_reg_history instead. Select the
                                                    // whole row rather than a named column - the column layout isn't consistent
                                                    // across VMs - and pull the version out of whatever text comes back.
                                                    echo "last_pkg_update() not found on ${vm.name} - falling back to ibis_reg_history"
                                                    def regHistRc = bat(
                                                        script: '''
                                                            set PGPASSWORD=%DB_PASSWORD%
                                                            psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT * FROM ibis_reg_history ORDER BY tim DESC LIMIT 1;" > reg_history_output.txt
                                                        ''',
                                                        returnStatus: true
                                                    )
                                                    if (regHistRc == 0) {
                                                        env.LAST_PKG_UPDATE_OUTPUT = readFile('reg_history_output.txt').trim()
                                                        echo "ibis_reg_history (latest row): ${env.LAST_PKG_UPDATE_OUTPUT}"
                                                        env.CURRENT_BUILD = extractBuildNumber(env.LAST_PKG_UPDATE_OUTPUT) ?: 'unknown'
                                                    } else {
                                                        echo "ibis_reg_history lookup also failed on ${vm.name} - treating build as unknown"
                                                        env.CURRENT_BUILD = 'unknown'
                                                    }
                                                }
                                                // Compare the extracted build numbers - both sources return a bare version like
                                                // "6.1.0.06", with no "build:" prefix to match on.
                                                env.ALREADY_UP_TO_DATE = (env.CURRENT_BUILD == env.INSTALLER_BUILD && !env.INSTALLER_HF) as String
                                                version = env.CURRENT_BUILD
                                                detail << [label: 'Current build', passed: null, value: env.ALREADY_UP_TO_DATE == 'true' ? "${env.CURRENT_BUILD} (up to date)" : "${env.CURRENT_BUILD}"]

                                                // Schema version (last_update()) tracks the IBIS database *structure*, separately
                                                // from the package build above - it changes less often and can legitimately lag
                                                // behind it (e.g. schema 6.0.0.218 with package build 6.1.0.06 is normal). It only
                                                // gates the install when the currently staged PG release notes state a minimum.
                                                def schemaRc = bat(
                                                    script: '''
                                                        set PGPASSWORD=%DB_PASSWORD%
                                                        psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT last_update();" > last_update_output.txt
                                                    ''',
                                                    returnStatus: true
                                                )
                                                def schemaVersion = (schemaRc == 0) ? extractBuildNumber(readFile('last_update_output.txt').trim()) : null
                                                echo "Schema version (last_update()) on ${vm.name}: ${schemaVersion ?: 'unknown'}"

                                                def schemaValid = true
                                                if (schemaVersion && env.MIN_SCHEMA_VERSION) {
                                                    schemaValid = (compareBuildVersions(schemaVersion, env.MIN_SCHEMA_VERSION) >= 0)
                                                    if (!schemaValid) {
                                                        echo "Schema version must be upgraded to ${env.MIN_SCHEMA_VERSION}"
                                                    }
                                                    detail << [label: 'Schema version', passed: schemaValid, value: schemaValid ? "${schemaVersion} (>= ${env.MIN_SCHEMA_VERSION})" : "${schemaVersion} (below minimum ${env.MIN_SCHEMA_VERSION})"]
                                                } else {
                                                    detail << [label: 'Schema version', passed: null, value: schemaVersion ?: 'unknown']
                                                }
                                                env.SCHEMA_VERSION_VALID = schemaValid as String

                                                if (env.ALREADY_UP_TO_DATE == 'true') {
                                                    echo "Skipping install on ${vm.name}: already at build ${env.INSTALLER_LABEL}, no need to upgrade"
                                                    detail << [label: 'Install', passed: null, value: 'Skipped - already up to date']
                                                    status = 'Skipped'
                                                } else if (params.DRY_RUN && env.CHECKCON_PASSED == 'true' && env.PG_VERSION_MATCHED == 'true' && env.VM_TYPE_VALID == 'true' && env.SITE_TYPE_VALID == 'true' && env.SCHEMA_VERSION_VALID == 'true') {
                                                    echo "DRY_RUN: all pre-checks passed on ${vm.name}, skipping installer"
                                                    detail << [label: 'Install', passed: null, value: 'Skipped - DRY_RUN (pre-checks passed)']
                                                    status = 'Skipped'
                                                } else if (env.CHECKCON_PASSED == 'true' && env.PG_VERSION_MATCHED == 'true' && env.VM_TYPE_VALID == 'true' && env.SITE_TYPE_VALID == 'true' && env.SCHEMA_VERSION_VALID == 'true') {
                                                    sendInProgressNotification(vm.name, pgUpgradeAvailable)

                                                    // Force out any remaining active connections rather than let them block the
                                                    // installer's exclusive lock - this disconnects whoever is currently using
                                                    // the database on this VM, right before the installer runs.
                                                    def killRc = bat(
                                                        script: '''
                                                            set PGPASSWORD=%DB_PASSWORD%
                                                            psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "WITH targets AS MATERIALIZED (SELECT pid FROM pg_stat_activity WHERE datname='ibis' AND pid<>pg_backend_pid()) SELECT count(*) FROM targets WHERE pg_terminate_backend(pid);" > killed_conns.txt
                                                        ''',
                                                        returnStatus: true
                                                    )
                                                    if (killRc == 0) {
                                                        def killedCount = readFile('killed_conns.txt').trim()
                                                        echo "Terminated ${killedCount} active connection(s) on ${vm.name} before installing"
                                                        detail << [label: 'Connections terminated', passed: null, value: killedCount]
                                                    } else {
                                                        echo "Could not terminate active connections on ${vm.name} (psql exit ${killRc}) - proceeding anyway"
                                                        detail << [label: 'Connections terminated', passed: false, value: "psql exit ${killRc}"]
                                                    }

                                                    try {
                                                        def extraArgsJoined = vm.extraArgs.join(',')
                                                        def installOutput
                                                        withEnv(["TARGET_HOST=${vm.name}", "EXTRA_ARGS=${extraArgsJoined}", "LOCAL_LOG=install-${vm.name}.log"]) {
                                                            installOutput = powershell(returnStdout: true, script: '''
                                                                $securePassword = ConvertTo-SecureString $env:DB_PASSWORD -AsPlainText -Force
                                                                $credential = New-Object System.Management.Automation.PSCredential("$env:DB_DOMAIN\\$env:DB_USER", $securePassword)
                                                                $session = New-PSSession -ComputerName $env:TARGET_HOST -Credential $credential

                                                                $remoteDir = "C:\\Temp"
                                                                $exeName = Split-Path $env:INSTALLER_PATH -Leaf
                                                                # A leftover, still-locked file from a prior stuck/hung install must never block a
                                                                # new attempt from copying - so the remote name is unique per Jenkins build.
                                                                $exeBase = [System.IO.Path]::GetFileNameWithoutExtension($exeName)
                                                                $exeExt = [System.IO.Path]::GetExtension($exeName)
                                                                $remotePath = Join-Path $remoteDir "$exeBase-build$env:BUILD_NUMBER$exeExt"
                                                                $remoteLog = Join-Path $remoteDir "ibis-install-$env:INSTALLER_BUILD.log"

                                                                Invoke-Command -Session $session -ScriptBlock {
                                                                    param($dir)
                                                                    New-Item -ItemType Directory -Force -Path $dir | Out-Null
                                                                } -ArgumentList $remoteDir

                                                                # Bail out before copying anything if the volume is short on space.
                                                                $freeGb = Invoke-Command -Session $session -ScriptBlock {
                                                                    [math]::Round((Get-PSDrive -Name C).Free / 1GB, 1)
                                                                }
                                                                Write-Output "FREEGB:$freeGb"
                                                                if ($freeGb -lt 5) {
                                                                    Remove-PSSession $session
                                                                    Write-Output "EXITCODE:8001"
                                                                    exit 0
                                                                }

                                                                Copy-Item -Path $env:INSTALLER_PATH -Destination $remotePath -ToSession $session

                                                                $extraArgs = @($env:EXTRA_ARGS -split ',' | Where-Object { $_ -ne '' })

                                                                $exitCode = Invoke-Command -Session $session -ScriptBlock {
                                                                    param($path, $log, $dbUser, $dbPwd, $extra)
                                                                    $installArgs = @(
                                                                        "/VerySilent",
                                                                        "/SUPPRESSMSGBOXES",
                                                                        "/NORESTART",
                                                                        "/LOG=$log",
                                                                        "/InstallType=UpgDB",
                                                                        "/UserName=$dbUser",
                                                                        "/UserPwd=$dbPwd"
                                                                    ) + $extra
                                                                    $p = Start-Process -FilePath $path -ArgumentList $installArgs -PassThru
                                                                    # WinRM runs this in session 0 with no desktop. A silent installer that
                                                                    # still pops a dialog would otherwise wait forever with no output.
                                                                    if (-not $p.WaitForExit(90 * 60 * 1000)) {
                                                                        $p.Kill()
                                                                        return 8002
                                                                    }
                                                                    return $p.ExitCode
                                                                } -ArgumentList $remotePath, $remoteLog, $env:DB_USER, $env:DB_PASSWORD, $extraArgs

                                                                # Pull the log back so it survives as a build artifact even on failure.
                                                                try {
                                                                    Copy-Item -Path $remoteLog -Destination $env:LOCAL_LOG -FromSession $session -ErrorAction Stop
                                                                } catch {
                                                                    Write-Output "LOGCOPY:failed - $($_.Exception.Message)"
                                                                }

                                                                Remove-PSSession $session

                                                                Write-Output "EXITCODE:$exitCode"
                                                            '''.trim())
                                                        }
                                                        echo installOutput
                                                        def exitLine = installOutput.readLines().find { it.startsWith('EXITCODE:') }
                                                        def exitCode = exitLine ? exitLine.replace('EXITCODE:', '').trim() : 'unknown'
                                                        // Inno Setup: 0 = done, 3010 = done but the machine wants a reboot.
                                                        // 8001 and 8002 are ours, set above.
                                                        if (exitCode == '0' || exitCode == '3010') {
                                                            if (exitCode == '3010') {
                                                                echo "Installer on ${vm.name} finished but reports a reboot is required."
                                                            }

                                                            // Trust the database, not the exit code. An installer can return 0
                                                            // without having changed anything.
                                                            def verifyRc = bat(
                                                                script: '''
                                                                    set PGPASSWORD=%DB_PASSWORD%
                                                                    psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT last_pkg_update();" > post_install_build.txt
                                                                ''',
                                                                returnStatus: true
                                                            )
                                                            def postBuild = (verifyRc == 0) ? extractBuildNumber(readFile('post_install_build.txt').trim()) : null

                                                            if (postBuild == env.INSTALLER_BUILD) {
                                                                version = postBuild
                                                                status = 'Success'
                                                                detail << [label: 'Install', passed: true, value: "installed build ${env.INSTALLER_LABEL}${exitCode == '3010' ? ' (reboot pending)' : ''}"]
                                                            } else {
                                                                echo "Post-install check on ${vm.name}: expected ${env.INSTALLER_BUILD}, database reports ${postBuild ?: 'unknown'}"
                                                                version = postBuild ?: env.CURRENT_BUILD
                                                                status = 'Failed'
                                                                detail << [label: 'Install', passed: false, value: "exit ${exitCode} but database still reports ${postBuild ?: 'unknown'}"]
                                                            }
                                                        } else {
                                                            def why = (exitCode == '8001') ? 'less than 5 GB free on C: - aborted before copying the installer'
                                                                    : (exitCode == '8002') ? 'installer still running after 90 min - killed'
                                                                    : "installer exit code ${exitCode}"
                                                            echo "Install on ${vm.name} failed: ${why}"
                                                            status = 'Failed'
                                                            detail << [label: 'Install', passed: false, value: why]
                                                        }
                                                    } catch (Exception installEx) {
                                                        echo "Remote install on ${vm.name} failed: ${installEx.getMessage()}"
                                                        status = 'Failed'
                                                        detail << [label: 'Install', passed: false, value: "remoting error: ${installEx.getMessage()}"]
                                                    }
                                                } else {
                                                    echo "Skipping install on ${vm.name}: CHECKCON_PASSED=${env.CHECKCON_PASSED}, PG_VERSION_MATCHED=${env.PG_VERSION_MATCHED}, VM_TYPE_VALID=${env.VM_TYPE_VALID}, SITE_TYPE_VALID=${env.SITE_TYPE_VALID}, SCHEMA_VERSION_VALID=${env.SCHEMA_VERSION_VALID}"
                                                    status = 'Failed'
                                                    detail << [label: 'Install', passed: false, value: 'Skipped - pre-check failed']
                                                }
                                            } else {
                                                detail << [label: 'PostgreSQL engine', passed: null, value: 'N/A - no connection']
                                                detail << [label: 'Consistency (checkcon)', passed: null, value: 'N/A - no connection']
                                                detail << [label: "PostgreSQL ${env.PG_VERSION_EXPECTED}", passed: null, value: 'N/A - no connection']
                                                detail << [label: 'VM type (sit_cod)', passed: null, value: 'N/A - no connection']
                                                if (group == 'LIR') {
                                                    detail << [label: 'Site type (LIR)', passed: null, value: 'N/A - no connection']
                                                }
                                                detail << [label: 'Current build', passed: null, value: 'N/A - no connection']
                                                detail << [label: 'Schema version', passed: null, value: 'N/A - no connection']
                                                detail << [label: 'Install', passed: false, value: 'Skipped - no connection']
                                                status = 'Failed'
                                            }
                                        }

    return [version: version, status: status]
}

def generateReportAndNotify(results, pgUpgradeAvailable) {
                            def statusMeta = [
                                'Success': [icon: '&#10003;', label: 'Success', token: 'good'],
                                'Failed':  [icon: '&#10007;', label: 'Failed',  token: 'critical'],
                                'Skipped': [icon: '&#8213;',  label: 'Skipped', token: 'warning']
                            ]
                            def checkMeta = [
                                (true):  [icon: '&#10003;', token: 'good'],
                                (false): [icon: '&#10007;', token: 'critical'],
                                (null):  [icon: '&#8213;',  token: 'warning']
                            ]

                            def successCount = results.count { it.status == 'Success' }
                            def failedCount  = results.count { it.status == 'Failed' }
                            def skippedCount = results.count { it.status == 'Skipped' }

                            // Regression Tests runs in its own top-level stage/script block, which
                            // doesn't see this stage's Groovy locals - hand it the successfully
                            // upgraded VM list via env, the only thing that persists across stages.
                            env.UPGRADED_VMS = results.findAll { it.status == 'Success' }.collect { it.name }.join(',')

                            def tile = { key, count ->
                                def meta = statusMeta[key]
                                """<div class="tile" style="border-left-color: var(--status-${meta.token});">
                                    <div class="tile-icon" style="background: var(--status-${meta.token}-bg); color: var(--status-${meta.token});">${meta.icon}</div>
                                    <div>
                                        <div class="tile-value">${count}</div>
                                        <div class="tile-label">${meta.label}</div>
                                    </div>
                                </div>"""
                            }

                            def phaseNames = ['CS': 'CS &mdash; Central Servers', 'LIR': 'LIR Sites', 'DCX': 'DCX Sites']
                            def phaseOrder = ['CS', 'LIR', 'DCX']

                            def tableSections = phaseOrder.findAll { p -> results.any { it.phase == p } }.collect { p ->
                                def sectionRows = results.findAll { it.phase == p }.collect { r ->
                                    def meta = statusMeta[r.status]
                                    def checkItems = r.detail.collect { d ->
                                        def cm = checkMeta[d.passed]
                                        """<div class="check-item">
                                            <span class="check-icon" style="background: var(--status-${cm.token}-bg); color: var(--status-${cm.token});">${cm.icon}</span>
                                            <span class="check-text"><strong>${d.label}:</strong> ${d.value}</span>
                                        </div>"""
                                    }.join('\n')

                                    """<tr>
                                        <td>${r.name}</td>
                                        <td class="num">${r.version ?: 'N/A'}</td>
                                        <td><span class="badge" style="background: var(--status-${meta.token}-bg);"><span class="badge-icon" style="color: var(--status-${meta.token});">${meta.icon}</span>${meta.label}</span></td>
                                    </tr>
                                    <tr class="detail-row">
                                        <td colspan="3">
                                            <div class="check-list">
                                                ${checkItems}
                                            </div>
                                        </td>
                                    </tr>"""
                                }.join('\n')

                                """<tr class="group-row"><td colspan="3">${phaseNames[p]}</td></tr>
                                ${sectionRows}"""
                            }.join('\n')

                            def html = """<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>IBIS Database Upgrade Report</title>
    <style>
        :root {
            --page:            #f9f9f7;
            --surface:         #fcfcfb;
            --text-primary:    #0b0b0b;
            --text-secondary:  #52514e;
            --text-muted:      #898781;
            --gridline:        #e1e0d9;
            --border:          rgba(11,11,11,0.10);
            --status-good:          #0ca30c;
            --status-good-bg:       #e5f6e5;
            --status-critical:      #d03b3b;
            --status-critical-bg:   #fbe6e6;
            --status-warning:       #fab219;
            --status-warning-bg:    #fff3da;
        }
        * { box-sizing: border-box; }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            background: var(--page);
            color: var(--text-primary);
            margin: 0;
            padding: 32px;
        }
        .container { max-width: 860px; margin: 0 auto; }
        h1 { font-size: 20px; font-weight: 600; margin: 0 0 4px; }
        .subtitle { color: var(--text-secondary); font-size: 13px; margin: 0 0 24px; }
        .tiles { display: flex; gap: 12px; margin-bottom: 24px; }
        .tile {
            flex: 1;
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 4px solid;
            border-radius: 6px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .tile-icon {
            width: 32px; height: 32px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px; font-weight: 700;
            flex-shrink: 0;
        }
        .tile-value { font-size: 28px; font-weight: 600; line-height: 1.1; }
        .tile-label { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }
        table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
        th, td { padding: 10px 16px; text-align: left; font-size: 13px; vertical-align: top; }
        th { background: var(--surface); color: var(--text-muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid var(--gridline); }
        td { border-bottom: 1px solid var(--gridline); color: var(--text-primary); }
        tr:last-child td { border-bottom: none; }
        td.num { font-variant-numeric: tabular-nums; color: var(--text-secondary); }
        .group-row td { background: var(--page); color: var(--text-secondary); font-weight: 600; font-size: 12px; padding: 8px 16px; border-bottom: 1px solid var(--gridline); }
        .badge { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; color: var(--text-primary); }
        .badge-icon { font-size: 12px; }
        .detail-row td { background: var(--page); padding: 8px 16px 14px 16px; }
        .check-list { display: flex; flex-wrap: wrap; gap: 8px 18px; }
        .check-item { display: flex; align-items: flex-start; gap: 6px; font-size: 12px; color: var(--text-secondary); }
        .check-icon {
            width: 16px; height: 16px; min-width: 16px;
            border-radius: 50%;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 10px; font-weight: 700;
            margin-top: 1px;
        }
        .check-text strong { color: var(--text-primary); font-weight: 600; }
    </style>
</head>
<body>
    <div class="container">
        <h1>IBIS Database Upgrade Report</h1>
        <p class="subtitle">Target build ${env.INSTALLER_LABEL} &middot; ${results.size()} VM(s) processed &middot; ${params.DRY_RUN ? 'DRY RUN - no installer executed' : 'live upgrade'} &middot; trigger: ${env.TRIGGER_CAUSE}</p>

        <div class="tiles">
            ${tile('Success', successCount)}
            ${tile('Failed', failedCount)}
            ${tile('Skipped', skippedCount)}
        </div>

        <table>
            <tr><th>VM</th><th>Version</th><th>Status</th></tr>
            ${tableSections}
        </table>
    </div>
</body>
</html>
"""

                            writeFile file: 'upgrade_report.html', text: html
                            archiveArtifacts artifacts: 'upgrade_report.html, install-*.log', allowEmptyArchive: true
                            echo "Report written to upgrade_report.html and archived as a build artifact"

                            // Don't re-alert on a failure that's already been reported and hasn't changed -
                            // that just repeats the same "known, unresolved" ping every night. A failure is
                            // "new" if this VM hasn't failed before, or has failed before but at a different
                            // target version (DB build and/or PG version) than what's recorded here. State
                            // persists in the workspace across builds since this job doesn't wipe it.
                            def notifyStateFile = 'teams_notified_failures.txt'
                            def notifiedFailures = [:]
                            if (fileExists(notifyStateFile)) {
                                readFile(notifyStateFile).trim().readLines().each { line ->
                                    def parts = line.split('=', 2)
                                    if (parts.length == 2) {
                                        notifiedFailures[parts[0]] = parts[1]
                                    }
                                }
                            }

                            def attemptSignature = "${env.INSTALLER_LABEL}|${env.PG_TARGET_VERSION ?: ''}"
                            def newFailureVms = []
                            results.each { r ->
                                if (r.status == 'Failed') {
                                    if (notifiedFailures[r.name] == attemptSignature) {
                                        echo "Suppressing repeat Teams notification for ${r.name} - already notified for this version"
                                    } else {
                                        newFailureVms << r.name
                                        notifiedFailures[r.name] = attemptSignature
                                    }
                                } else if (r.status == 'Success') {
                                    // Resolved - a future failure at any version should notify fresh again.
                                    notifiedFailures.remove(r.name)
                                }
                            }
                            writeFile file: notifyStateFile, text: notifiedFailures.collect { k, v -> "${k}=${v}" }.join('\n')

                            // Nothing to tell anyone if every VM was already up to date, or if the only
                            // failures present are ones already notified and still unresolved.
                            if (successCount > 0 || newFailureVms.size() > 0) {
                                def overallResult = currentBuild.currentResult ?: 'SUCCESS'
                                def resultColor = (overallResult == 'SUCCESS') ? 'good' : (overallResult == 'FAILURE') ? 'attention' : 'warning'
                                def resultIcon = (overallResult == 'SUCCESS') ? '✅' : (overallResult == 'FAILURE') ? '❌' : '⚠️'

                                def vmFacts = results.collect { r ->
                                    def pgDetail = r.detail.find { it.label == 'PostgreSQL engine' }
                                    def pgValue = pgDetail?.value?.toString()
                                    def pgText = (pgValue && !pgValue.startsWith('N/A')) ? " (PG: ${pgValue})" : ''
                                    """{"title": "${jsonEscape(r.name)} (${jsonEscape(r.phase)})", "value": "${jsonEscape(r.status)} - build ${jsonEscape(r.version ?: 'N/A')}${jsonEscape(pgText)}"}"""
                                }.join(',\n')

                                def pgTargetFact = pgUpgradeAvailable ? ",\n{\"title\": \"PG target version\", \"value\": \"${jsonEscape(env.PG_TARGET_VERSION)}\"}" : ''

                                def teamsCard = """{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "content": {
                "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                    {
                        "type": "TextBlock",
                        "text": "${resultIcon} IBIS DB Upgrade Report",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "${resultColor}"
                    },
                    {
                        "type": "TextBlock",
                        "text": "${params.DRY_RUN ? 'DRY_RUN' : 'LIVE upgrade'} • ${jsonEscape(env.TRIGGER_CAUSE)}",
                        "isSubtle": true,
                        "wrap": true
                    },
                    {
                        "type": "FactSet",
                        "facts": [
                            {"title": "DB target build", "value": "${jsonEscape(env.INSTALLER_LABEL)}"}${pgTargetFact},
                            {"title": "Result", "value": "${successCount} success / ${failedCount} failed / ${skippedCount} skipped"},
                            ${vmFacts}
                        ]
                    }
                ],
                "actions": [
                    {
                        "type": "Action.OpenUrl",
                        "title": "View build",
                        "url": "${env.BUILD_URL}"
                    }
                ]
            }
        }
    ]
}"""

                                // Explicit UTF-8 - the card text has emoji and a bullet character, and
                                // writeFile's default platform charset on Windows can mangle those into
                                // invalid JSON, which Power Automate then rejects with a 400.
                                writeFile file: 'teams_card.json', text: teamsCard, encoding: 'UTF-8'
                                withCredentials([string(credentialsId: 'Teams-PGUP', variable: 'TEAMS_WEBHOOK_URL')]) {
                                    try {
                                        powershell '''
                                            try {
                                                $response = Invoke-WebRequest -Uri $env:TEAMS_WEBHOOK_URL -Method Post -ContentType 'application/json' -InFile 'teams_card.json' -UseBasicParsing
                                                Write-Output "Teams webhook response: HTTP $($response.StatusCode) - $($response.Content)"
                                            } catch {
                                                $statusCode = $null
                                                $body = $null
                                                if ($_.Exception.Response) {
                                                    $statusCode = [int]$_.Exception.Response.StatusCode
                                                    $stream = $_.Exception.Response.GetResponseStream()
                                                    if ($stream) {
                                                        $body = (New-Object System.IO.StreamReader($stream)).ReadToEnd()
                                                    }
                                                }
                                                Write-Output "Teams webhook error: HTTP $statusCode - $body"
                                                throw
                                            }
                                        '''
                                        echo "Teams notification sent"
                                    } catch (Exception teamsEx) {
                                        echo "Failed to send Teams notification: ${teamsEx.getMessage()}"
                                    }
                                }
                            } else {
                                echo "Skipping Teams notification - no VM was upgraded, and any failure(s) present were already notified for this version"
                            }
}

// Runs once before any VM is actually touched for install, using only a lightweight
// connectivity + current-build check (no checkcon, no PG/schema/site-type gating - those
// still happen for real in processVm right before the install itself). Purely to know which
// target VMs are behind the staged build so the "starting in N minutes" warning below is
// accurate rather than firing for VMs that turn out to already be up to date.
def checkNeedsUpgrade(vmName) {
    env.DB_HOST = vmName
    def connRc = bat(
        script: '''
            set PGPASSWORD=%DB_PASSWORD%
            psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -c "SELECT 1;"
        ''',
        returnStatus: true
    )
    if (connRc != 0) {
        return [reachable: false]
    }

    def buildRc = bat(
        script: '''
            set PGPASSWORD=%DB_PASSWORD%
            psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT last_pkg_update();" > pre_check_build.txt
        ''',
        returnStatus: true
    )
    def currentBuild = (buildRc == 0) ? extractBuildNumber(readFile('pre_check_build.txt').trim()) : null
    if (!currentBuild) {
        // last_pkg_update() doesn't exist on older schemas - same ibis_reg_history fallback
        // processVm uses for the real, later check.
        def regHistRc = bat(
            script: '''
                set PGPASSWORD=%DB_PASSWORD%
                psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT * FROM ibis_reg_history ORDER BY tim DESC LIMIT 1;" > pre_check_reg_history.txt
            ''',
            returnStatus: true
        )
        currentBuild = (regHistRc == 0) ? extractBuildNumber(readFile('pre_check_reg_history.txt').trim()) : null
    }

    def needsUpgrade = !(currentBuild == env.INSTALLER_BUILD && !env.INSTALLER_HF)
    return [reachable: true, currentBuild: currentBuild ?: 'unknown', needsUpgrade: needsUpgrade]
}

// Sent once, before any VM is actually touched, so operators get advance notice instead of
// only finding out an upgrade is underway once it has already started (see
// sendInProgressNotification for that per-VM "in progress" ping). Only fires when at least
// one target VM is actually behind the staged build.
def sendPreUpgradeWarning(vmsNeedingUpgrade, fromLabel, toLabel) {
    def vmFacts = vmsNeedingUpgrade.collect { "{\"title\": \"${jsonEscape(it)}\", \"value\": \"upgrade needed\"}" }.join(',\n')

    def card = """{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "content": {
                "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                    {
                        "type": "TextBlock",
                        "text": "⚠️ Upgrade from ${jsonEscape(fromLabel)} to ${jsonEscape(toLabel)} of the following VMs will start in 30 minutes",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "warning",
                        "wrap": true
                    },
                    {
                        "type": "TextBlock",
                        "text": "${jsonEscape(env.TRIGGER_CAUSE)}",
                        "isSubtle": true,
                        "wrap": true
                    },
                    {
                        "type": "FactSet",
                        "facts": [
                            ${vmFacts}
                        ]
                    }
                ],
                "actions": [
                    {
                        "type": "Action.OpenUrl",
                        "title": "View build",
                        "url": "${env.BUILD_URL}"
                    }
                ]
            }
        }
    ]
}"""

    writeFile file: 'teams_card_pre_upgrade.json', text: card, encoding: 'UTF-8'
    withCredentials([string(credentialsId: 'Teams-PGUP', variable: 'TEAMS_WEBHOOK_URL')]) {
        try {
            powershell '''
                try {
                    $response = Invoke-WebRequest -Uri $env:TEAMS_WEBHOOK_URL -Method Post -ContentType 'application/json' -InFile 'teams_card_pre_upgrade.json' -UseBasicParsing
                    Write-Output "Teams webhook response: HTTP $($response.StatusCode) - $($response.Content)"
                } catch {
                    $statusCode = $null
                    $body = $null
                    if ($_.Exception.Response) {
                        $statusCode = [int]$_.Exception.Response.StatusCode
                        $stream = $_.Exception.Response.GetResponseStream()
                        if ($stream) {
                            $body = (New-Object System.IO.StreamReader($stream)).ReadToEnd()
                        }
                    }
                    Write-Output "Teams webhook error: HTTP $statusCode - $body"
                    throw
                }
            '''
            echo "Teams pre-upgrade warning sent"
        } catch (Exception teamsEx) {
            echo "Failed to send Teams pre-upgrade warning: ${teamsEx.getMessage()}"
        }
    }
}

// Sent once, right as the Regression Tests stage begins, naming the VMs about to be checked.
def sendRegressionStartNotification(vmNames) {
    def vmList = vmNames.collect { jsonEscape(it) }.join(', ')

    def card = """{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "content": {
                "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                    {
                        "type": "TextBlock",
                        "text": "🧪 Regression tests starting",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "warning"
                    },
                    {
                        "type": "TextBlock",
                        "text": "${jsonEscape(env.TRIGGER_CAUSE)}",
                        "isSubtle": true,
                        "wrap": true
                    },
                    {
                        "type": "FactSet",
                        "facts": [
                            {"title": "VMs", "value": "${vmList}"}
                        ]
                    }
                ],
                "actions": [
                    {
                        "type": "Action.OpenUrl",
                        "title": "View build",
                        "url": "${env.BUILD_URL}"
                    }
                ]
            }
        }
    ]
}"""

    writeFile file: 'teams_card_regression_start.json', text: card, encoding: 'UTF-8'
    withCredentials([string(credentialsId: 'Teams-PGUP', variable: 'TEAMS_WEBHOOK_URL')]) {
        try {
            powershell '''
                try {
                    $response = Invoke-WebRequest -Uri $env:TEAMS_WEBHOOK_URL -Method Post -ContentType 'application/json' -InFile 'teams_card_regression_start.json' -UseBasicParsing
                    Write-Output "Teams webhook response: HTTP $($response.StatusCode) - $($response.Content)"
                } catch {
                    $statusCode = $null
                    $body = $null
                    if ($_.Exception.Response) {
                        $statusCode = [int]$_.Exception.Response.StatusCode
                        $stream = $_.Exception.Response.GetResponseStream()
                        if ($stream) {
                            $body = (New-Object System.IO.StreamReader($stream)).ReadToEnd()
                        }
                    }
                    Write-Output "Teams webhook error: HTTP $statusCode - $body"
                    throw
                }
            '''
            echo "Teams regression-start notification sent"
        } catch (Exception teamsEx) {
            echo "Failed to send Teams regression-start notification: ${teamsEx.getMessage()}"
        }
    }
}

// Sent once, at the end of the Regression Tests stage - a single pass/fail card naming exactly
// which check(s) failed on which VM(s), so a failure is actionable without digging into the log.
def sendRegressionResultNotification(regressionResults) {
    def failedResults = regressionResults.findAll { !it.passed }
    def resultIcon = failedResults.isEmpty() ? '✅' : '❌'
    def resultColor = failedResults.isEmpty() ? 'good' : 'attention'
    def summaryText = failedResults.isEmpty() ? 'Regression tests passed' : 'Regression tests FAILED'

    def vmFacts = regressionResults.collect { r ->
        def value = r.passed ? 'passed' : "FAILED - ${r.failedChecks.join(', ')}"
        """{"title": "${jsonEscape(r.host)}", "value": "${jsonEscape(value)}"}"""
    }.join(',\n')

    def card = """{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "content": {
                "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                    {
                        "type": "TextBlock",
                        "text": "${resultIcon} ${summaryText}",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "${resultColor}"
                    },
                    {
                        "type": "TextBlock",
                        "text": "${jsonEscape(env.TRIGGER_CAUSE)}",
                        "isSubtle": true,
                        "wrap": true
                    },
                    {
                        "type": "FactSet",
                        "facts": [
                            ${vmFacts}
                        ]
                    }
                ],
                "actions": [
                    {
                        "type": "Action.OpenUrl",
                        "title": "View build",
                        "url": "${env.BUILD_URL}"
                    }
                ]
            }
        }
    ]
}"""

    writeFile file: 'teams_card_regression_result.json', text: card, encoding: 'UTF-8'
    withCredentials([string(credentialsId: 'Teams-PGUP', variable: 'TEAMS_WEBHOOK_URL')]) {
        try {
            powershell '''
                try {
                    $response = Invoke-WebRequest -Uri $env:TEAMS_WEBHOOK_URL -Method Post -ContentType 'application/json' -InFile 'teams_card_regression_result.json' -UseBasicParsing
                    Write-Output "Teams webhook response: HTTP $($response.StatusCode) - $($response.Content)"
                } catch {
                    $statusCode = $null
                    $body = $null
                    if ($_.Exception.Response) {
                        $statusCode = [int]$_.Exception.Response.StatusCode
                        $stream = $_.Exception.Response.GetResponseStream()
                        if ($stream) {
                            $body = (New-Object System.IO.StreamReader($stream)).ReadToEnd()
                        }
                    }
                    Write-Output "Teams webhook error: HTTP $statusCode - $body"
                    throw
                }
            '''
            echo "Teams regression-result notification sent"
        } catch (Exception teamsEx) {
            echo "Failed to send Teams regression-result notification: ${teamsEx.getMessage()}"
        }
    }
}

pipeline {
    agent { label 'built-in' }

    parameters {
        string(
            name: 'TARGET_VMS',
            defaultValue: 'SVR3-009-SEC,DCXA-004-SEC,DCX2-004-SEC,DCX3-004-SEC,SVR5-004-SEC,SVR4-004-SEC,DCX1-004-SEC,DCXC-004-SEC',
            description: 'Comma-separated VM names to process. The nightly scheduled build uses this default value, so keep it narrow. Valid names: SVR4-004-SEC, SVR3-009-SEC, SVR5-004-SEC, SVR6-004-SEC, DCXA-004-SEC, DCXB-004-SEC, DCXC-004-SEC, DCX2-003-SEC, DCX2-004-SEC, DCX3-004-SEC, DCX4-004-SEC, DCX1-004-SEC, DCX2-003-TST'
        )
        string(
            name: 'INSTALLER_FILE',
            defaultValue: '',
            description: 'Exact installer file name to force, e.g. "SOFTW-01442-00 - IBIS Database 6.1.0.06.exe". Takes precedence over INSTALLER_VERSION, and is the only way to target a hotfix unambiguously. Leave blank on the nightly schedule - it auto-detects the newest installer under INSTALLER_DIR.'
        )
        string(
            name: 'INSTALLER_VERSION',
            defaultValue: '',
            description: 'Installer build to force, e.g. 6.1.0.06, matched as *<version>*.exe. Used when no exact file name is given. Leave blank on the nightly schedule - it auto-detects the newest installer under INSTALLER_DIR.'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Run every pre-check but skip the installer. The nightly schedule runs with this false (live) by default - set true only to validate a change without touching a database.'
        )
    }

    options {
        // A manually triggered run must never stack on top of the nightly one still in progress.
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
    }

    triggers {
        // Poll the DBA share (via the Y: mapping) once a night at 1 AM for a new installer.
        cron('0 1 * * *')
    }

    environment {
        DB_PORT             = '1815'
        // dja is only granted access via hostssl rules in pg_hba.conf, so an
        // unencrypted connection matches nothing and is rejected. Force SSL.
        PGSSLMODE           = 'require'
        DB_NAME             = 'ibis'
        DB_DOMAIN           = 'SEC'
        DB_USER             = 'dja'
        DB_PASSWORD         = credentials('db-password')
        PG_VERSION_EXPECTED = '17.10'
        // DB packages and PG engine installers are both staged on the DBA team's share now,
        // and Y: is mapped to \\10.140.6.15\public below (build_transfert is no longer used
        // for either). INSTALLER_DIR/PG_INSTALLER_DIR point at their respective subfolders,
        // e.g. "Y:\IBIS Database\SOFTW-01442-00 - IBIS Database 6.1.0.06.exe".
        INSTALLER_DIR       = 'Y:\\IBIS Database'
        // e.g. "Y:\PG Intaller\PG17\SOFTW-01398-xx PostgreSQL 17 Installer vx.x.x.x.exe".
        PG_INSTALLER_DIR    = 'Y:\\PG Intaller'
    }

    stages {
        stage('Ensure installer drive mapped') {
            steps {
                script {
                    def driveCheckRc = bat(script: '@net use Y: >nul 2>&1', returnStatus: true)
                    if (driveCheckRc == 0) {
                        echo 'Y: already mapped - reusing existing mapping'
                    } else {
                        echo 'Y: not mapped - mapping to \\\\10.140.6.15\\public'
                        withCredentials([usernamePassword(credentialsId: 'build_transfer', usernameVariable: 'SMB_USER', passwordVariable: 'SMB_PASSWORD')]) {
                            def mapRc = bat(script: '@net use Y: \\\\10.140.6.15\\public /user:%SMB_USER% %SMB_PASSWORD%', returnStatus: true)
                            if (mapRc != 0) {
                                error('Failed to map Y: to \\\\10.140.6.15\\public using the build_transfer credential.')
                            }
                        }
                    }
                }
            }
        }
        stage('Upgrade VMs') {
            steps {
                script {
                    // Authoritative registry of every VM and its installer overrides.
                    // TARGET_VMS selects a subset from this list; it never adds to it.
                    def allVms = [
                        [name: 'SVR4-004-SEC', extraArgs: []],
                        [name: 'SVR3-009-SEC', extraArgs: []],
                        [name: 'SVR5-004-SEC', extraArgs: []],
                        [name: 'SVR6-004-SEC', extraArgs: []],
                        [name: 'DCXA-004-SEC', extraArgs: []],
                        [name: 'DCXB-004-SEC', extraArgs: []],
                        [name: 'DCXC-004-SEC', extraArgs: []],
                        [name: 'DCX2-003-SEC', extraArgs: []],
                        [name: 'DCX2-004-SEC', extraArgs: ['/IbisSchema=CHM']],
                        [name: 'DCX4-004-SEC', extraArgs: []],
                        [name: 'DCX1-004-SEC', extraArgs: []],
                        [name: 'DCX3-004-SEC', extraArgs: []],
                        [name: 'DCX2-003-TST', extraArgs: []]
                    ]

                    def requested = (params.TARGET_VMS ?: '').split(',').collect { it.trim().toUpperCase() }.findAll { it }
                    if (!requested) {
                        error('TARGET_VMS is empty - nothing to process.')
                    }
                    def knownNames = allVms.collect { it.name.toUpperCase() }
                    def unknown = requested.findAll { !knownNames.contains(it) }
                    if (unknown) {
                        error("Unknown VM name(s) in TARGET_VMS: ${unknown.join(', ')}. Valid names: ${allVms.collect { it.name }.join(', ')}")
                    }
                    def vms = allVms.findAll { requested.contains(it.name.toUpperCase()) }

                    def triggerCause = 'unknown'
                    try {
                        triggerCause = currentBuild.getBuildCauses().collect { it.shortDescription }.join(', ')
                    } catch (Exception ignored) { }
                    // Mirrored to env so the top-level helper functions below (processVm,
                    // sendInProgressNotification, ...) can read it - they're separate CPS
                    // methods and don't see this stage's Groovy locals.
                    env.TRIGGER_CAUSE = triggerCause

                    echo "Trigger: ${triggerCause}"
                    echo "Mode: ${params.DRY_RUN ? 'DRY_RUN - installer will be skipped' : 'LIVE upgrade'}"
                    echo "Targeting ${vms.size()} of ${allVms.size()} VM(s): ${vms.collect { it.name }.join(', ')}"

                    // Which installer to apply. An explicit param forces a specific one; the
                    // nightly schedule passes neither and auto-detects whatever is newest.
                    def wantedFile    = (params.INSTALLER_FILE ?: '').trim()
                    def wantedVersion = (params.INSTALLER_VERSION ?: '').trim()
                    def autoDetect    = !wantedFile && !wantedVersion

                    // Resolve the staged installer on the DBA share (via the Y: mapping).
                    // New versions land in their own subfolder, e.g. "DB 6.1.0.06\SOFTW-01442-00 -
                    // IBIS Database 6.1.0.06.exe", so the search recurses instead of looking only
                    // directly inside INSTALLER_DIR. Groovy file access is blocked by the pipeline
                    // sandbox, so the lookup runs through PowerShell.
                    def pattern = wantedFile ?: (wantedVersion ? "*${wantedVersion}*.exe" : '*.exe')
                    def resolved = powershell(returnStdout: true, script: """
                        \$f = Get-ChildItem -Path '${env.INSTALLER_DIR}' -Recurse -Filter '${pattern}' -File -ErrorAction SilentlyContinue |
                              Sort-Object LastWriteTime -Descending | Select-Object -First 1
                        if (\$f) { Write-Output \$f.FullName }
                    """).trim()
                    if (!resolved) {
                        if (autoDetect) {
                            // Routine outcome of the nightly check, not a failure - just nothing new yet.
                            echo "No installer found under ${env.INSTALLER_DIR} (\\\\10.140.6.15\\public\\IBIS Database) - nothing to do this run."
                            return
                        }
                        error("No installer matching '${pattern}' under ${env.INSTALLER_DIR} (\\\\10.140.6.15\\public\\IBIS Database).")
                    }
                    env.INSTALLER_PATH = resolved

                    def resolvedName = resolved.tokenize('\\').last()
                    env.INSTALLER_BUILD = extractBuildNumber(resolvedName)
                    if (!env.INSTALLER_BUILD) {
                        error("Cannot read a build number from '${resolvedName}'. The file name must contain x.x.x.x.")
                    }

                    // A hotfix is named "... 6.0.0.107 HF1.4.exe" but last_pkg_update() is not
                    // known to report the HF marker, so a hotfix can never be proven to be
                    // already installed. It is always applied rather than skipped.
                    env.INSTALLER_HF    = extractHotfix(resolvedName) ?: ''
                    env.INSTALLER_LABEL = env.INSTALLER_HF ? "${env.INSTALLER_BUILD} ${env.INSTALLER_HF}" : env.INSTALLER_BUILD

                    echo "Installer: ${env.INSTALLER_PATH}"
                    echo "Installer build: ${env.INSTALLER_LABEL}"

                    // The PostgreSQL engine upgrade always precedes the database upgrade, so
                    // resolve it once up front, same as the database installer above. Absence
                    // of a new version folder is normal - most runs have nothing to do here.
                    def pgFolder = powershell(returnStdout: true, script: """
                        \$d = Get-ChildItem -Path '${env.PG_INSTALLER_DIR}' -Directory -ErrorAction SilentlyContinue |
                              Sort-Object LastWriteTime -Descending | Select-Object -First 1
                        if (\$d) { Write-Output \$d.FullName }
                    """).trim()

                    def pgUpgradeAvailable = false
                    if (pgFolder) {
                        def pgExe = powershell(returnStdout: true, script: """
                            \$f = Get-ChildItem -LiteralPath '${pgFolder}' -Filter '*.exe' -File -ErrorAction SilentlyContinue | Select-Object -First 1
                            if (\$f) { Write-Output \$f.FullName }
                        """).trim()
                        // The release notes file name varies per release but always contains
                        // "Release Notes", e.g. "SOFTW-01398-00 - PostgreSQL 17 Installer Release Notes.txt".
                        def pgNotesPath = powershell(returnStdout: true, script: """
                            \$f = Get-ChildItem -LiteralPath '${pgFolder}' -Filter '*Release Notes*.txt' -File -ErrorAction SilentlyContinue | Select-Object -First 1
                            if (\$f) { Write-Output \$f.FullName }
                        """).trim()

                        if (!pgExe || !pgNotesPath) {
                            error("Found PostgreSQL folder '${pgFolder}' but it is missing the installer .exe or a '*Release Notes*.txt' file - cannot determine the target version safely.")
                        }

                        def pgNotesText = powershell(returnStdout: true, script: "Get-Content -LiteralPath '${pgNotesPath}' -Raw").trim()
                        def pgTargetVersion = extractPgTargetVersion(pgNotesText)
                        if (!pgTargetVersion) {
                            error("Could not read a target PostgreSQL version (e.g. '17.6') out of '${pgNotesPath}'.")
                        }

                        env.PG_EXE_PATH       = pgExe
                        env.PG_TARGET_VERSION = pgTargetVersion
                        env.PG_TARGET_MAJOR   = pgTargetVersion.tokenize('.')[0]
                        pgUpgradeAvailable    = true

                        echo "PostgreSQL installer: ${env.PG_EXE_PATH}"
                        echo "PostgreSQL target version: ${env.PG_TARGET_VERSION} (per ${pgNotesPath})"

                        // Same release notes file also states the minimum IBIS schema version
                        // (last_update()) required before the DB package can be applied. Not
                        // every release notes file states one, so its absence is not an error.
                        env.MIN_SCHEMA_VERSION = extractMinSchemaVersion(pgNotesText) ?: ''
                        if (env.MIN_SCHEMA_VERSION) {
                            echo "Minimum required schema version: ${env.MIN_SCHEMA_VERSION} (per ${pgNotesPath})"
                        }
                    } else {
                        echo "No new PostgreSQL version folder under ${env.PG_INSTALLER_DIR} - skipping PostgreSQL engine check."
                    }

                    def results = []

                    stage('Pre-upgrade check') {
                        // A DRY_RUN never actually installs anything, so a "will start in N
                        // minutes" warning followed by a real wait would be misleading and just
                        // waste time on a validation-only run - skip the whole check.
                        if (params.DRY_RUN) {
                            echo 'DRY_RUN: skipping the pre-upgrade warning and wait.'
                        } else {
                            // Lightweight check only - which target VMs are actually behind the
                            // staged build. Skips the warning and wait entirely when nothing is behind.
                            def vmsNeedingUpgrade = []
                            def fromBuilds = []
                            for (vm in vms) {
                                def check = checkNeedsUpgrade(vm.name)
                                if (check.reachable && check.needsUpgrade) {
                                    vmsNeedingUpgrade << vm.name
                                    fromBuilds << check.currentBuild
                                }
                            }

                            if (vmsNeedingUpgrade) {
                                def fromLabel = fromBuilds.unique().sort().join('/')
                                sendPreUpgradeWarning(vmsNeedingUpgrade, fromLabel, env.INSTALLER_LABEL)
                                echo "Upgrade needed on: ${vmsNeedingUpgrade.join(', ')} - waiting 30 minutes before starting"
                                sleep(time: 30, unit: 'MINUTES')
                            } else {
                                echo 'No target VM is behind the staged build - skipping the pre-upgrade warning and wait.'
                            }
                        }
                    }

                    // Order matters: CS (SVR*) must succeed before LIR (DCXA*/DCXB*/DCXC*), and LIR before the plain DCX group.
                    def phases = [
                        [label: 'CS',  vms: vms.findAll { classifyGroup(it.name) == 'CS' },  gate: true],
                        [label: 'LIR', vms: vms.findAll { classifyGroup(it.name) == 'LIR' }, gate: true],
                        [label: 'DCX', vms: vms.findAll { classifyGroup(it.name) == 'DCX' }, gate: false]
                    ]

                    try {
                        for (phase in phases) {
                            if (phase.vms.isEmpty()) {
                                continue
                            }

                            stage("Phase: ${phase.label}") {
                                for (vm in phase.vms) {
                                    def group = phase.label
                                    def detail = []
                                    def version = 'N/A'
                                    def status = 'Failed'

                                    try {
                                        def result = processVm(vm, group, pgUpgradeAvailable, detail)
                                        version = result.version
                                        status = result.status
                                    } catch (Exception e) {
                                        echo "VM ${vm.name} processing failed unexpectedly: ${e.getMessage()}"
                                        detail << [label: 'Unexpected error', passed: false, value: e.getMessage()]
                                        status = 'Failed'
                                        currentBuild.result = 'FAILURE'
                                    }

                                    // A pre-check failure (active connections, PG version not yet upgraded, etc.)
                                    // is expected, routine output of a DRY_RUN - it means "not ready yet", not
                                    // "something is broken" - so it shouldn't flip the whole build to FAILURE.
                                    // An unexpected exception still does, via the catch block above.
                                    if (status == 'Failed' && !params.DRY_RUN) {
                                        currentBuild.result = 'FAILURE'
                                    }

                                    results << [name: vm.name, phase: group, version: version, status: status, detail: detail]

                                    // A failed PostgreSQL engine upgrade aborts the whole pipeline rather
                                    // than just this VM - the database upgrade must never run against an
                                    // engine left in an unknown/half-upgraded state. This is deliberately
                                    // outside the per-VM try/catch above so it isn't swallowed as a
                                    // per-VM failure; it still reaches the Generate Report stage via the
                                    // outer try/finally before failing the build.
                                    if (env.PG_UPGRADE_ABORTED == 'true') {
                                        error("Aborting: ${env.PG_UPGRADE_ERROR}")
                                    }
                                }
                            }

                            // Same reasoning as above - DRY_RUN should finish checking every phase to give a
                            // full picture, not abort partway through on a routine "not ready yet" pre-check.
                            if (phase.gate && !params.DRY_RUN) {
                                def phaseVmNames = phase.vms.collect { it.name }
                                def phaseFailures = results.findAll { it.name in phaseVmNames && it.status == 'Failed' }
                                if (phaseFailures) {
                                    error("Stopping pipeline: ${phase.label} phase had failure(s) on: ${phaseFailures.collect { it.name }.join(', ')}")
                                }
                            }
                        }
                    } finally {
                        stage('Generate Report') {
                            generateReportAndNotify(results, pgUpgradeAvailable)
                        }
                    }
                }
            }
        }
        stage('Regression Tests') {
            steps {
                script {
                    // Per regression.txt:
                    //   1. db Integrity: run the checks without the pgdump - implemented below,
                    //      re-running checkcon() against every VM actually upgraded this build.
                    //   2. Workflow of a case creation (correlation + hit creation) - not yet.
                    //   3. CHM - not yet.
                    def upgradedVms = (env.UPGRADED_VMS ?: '').split(',').findAll { it }
                    if (upgradedVms.isEmpty()) {
                        echo 'Regression: no VM was upgraded this run - nothing to test.'
                        return
                    }

                    sendRegressionStartNotification(upgradedVms)

                    echo "Regression starting for: ${upgradedVms.join(', ')}"
                    // Each key is the exact substring checkcon() prints when that check passes;
                    // the value is what to report when it's ABSENT (i.e. the check failed).
                    def checkDescriptions = [
                        '0 disabled trigger found'                                : 'disabled triggers found',
                        '0 disabled constraint(s) found'                          : 'disabled constraints found',
                        'materialized view(s) refreshed'                          : 'materialized views not refreshed',
                        'Images and signatures partition definitions are compliant.': 'partition definitions non-compliant',
                        'Table scan_partitions is compliant.'                     : 'scan_partitions non-compliant'
                    ]
                    def regressionResults = []
                    for (host in upgradedVms) {
                        env.DB_HOST = host
                        def rc = bat(
                            script: '''
                                set PGPASSWORD=%DB_PASSWORD%
                                psql -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -c "SELECT checkcon();" > regression_checkcon_output.txt
                            ''',
                            returnStatus: true
                        )
                        if (rc != 0) {
                            currentBuild.result = 'FAILURE'
                            echo "Regression FAILED on ${host}: could not run checkcon() (psql exit ${rc})"
                            regressionResults << [host: host, passed: false, failedChecks: ["could not run checkcon() (psql exit ${rc})"]]
                            continue
                        }

                        def output = readFile('regression_checkcon_output.txt').trim()
                        echo "Regression checkcon() on ${host}:\n${output}"
                        def failedChecks = checkDescriptions.findAll { marker, label -> !output.contains(marker) }.collect { marker, label -> label }
                        if (failedChecks) {
                            currentBuild.result = 'FAILURE'
                            echo "Regression FAILED on ${host}: ${failedChecks.join(', ')}"
                            regressionResults << [host: host, passed: false, failedChecks: failedChecks]
                        } else {
                            echo "Regression passed on ${host}"
                            regressionResults << [host: host, passed: true, failedChecks: []]
                        }
                    }

                    sendRegressionResultNotification(regressionResults)
                }
            }
        }
    }
}
