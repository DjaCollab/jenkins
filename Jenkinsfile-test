// The exact text checkcon() prints for each check that passes.
@NonCPS
def checkconPassMarkers() {
    return [
        '0 disabled trigger found',
        '0 disabled constraint(s) found',
        'materialized view(s) refreshed',
        'Images and signatures partition definitions are compliant.',
        'Table scan_partitions is compliant.'
    ]
}

// True when every check reports as passed in a checkcon() output.
@NonCPS
def checkconPassed(String output) {
    return checkconPassMarkers().every { (output ?: '').contains(it) }
}

// The lines of a checkcon() output that report a problem, joined for a one-line card
// value - a line counts as fine when it contains one of the "check passed" markers.
// Falls back to the whole output when no single line stands out (e.g. a line is missing).
@NonCPS
def checkconFailingLines(String output) {
    def passMarkers = checkconPassMarkers()
    def lines = (output ?: '').readLines().collect { it.trim() }.findAll { it }
    def failing = lines.findAll { line -> !passMarkers.any { line.contains(it) } }
    return (failing ?: lines).join(' / ') ?: '(no output)'
}

// checkcon() failures found by processVm (before any install), for the final result card:
// each is shown next to its VM - red (❌) when the VM needed an upgrade and the failure
// blocked it, warning (⚠️) when the VM was already up to date and not upgraded.
// Returns [notes: [vmName: text], fresh: true if any is new]. With the job running every
// 4 hours, a failure whose output hasn't changed since it was last reported doesn't make
// the card go out again on its own; it counts as new once the output changes, or after
// the VM has passed once.
def collectCheckconNotes(results) {
    def stateFile = 'teams_notified_checkcon.txt'
    def notified = [:]
    if (fileExists(stateFile)) {
        readFile(stateFile).trim().readLines().each { line ->
            def parts = line.split('=', 2)
            if (parts.length == 2) {
                notified[parts[0]] = parts[1]
            }
        }
    }

    def notes = [:]
    def fresh = false
    for (r in results) {
        def cc = r.detail.find { it.label == 'Consistency (checkcon)' }
        if (cc?.passed == true) {
            notified.remove(r.name)
        } else if (cc?.passed == false) {
            def critical = r.status != 'Skipped'
            def text = checkconFailingLines(cc.output)
            notes[r.name] = "${critical ? '❌ checkcon failed, install blocked' : '⚠️ checkcon failed'}: ${text}"
            def signature = "${critical ? 'red' : 'warning'}|${text}"
            if (notified[r.name] == signature) {
                echo "checkcon() on ${r.name}: same failure already reported - not a reason on its own to send the card"
            } else {
                fresh = true
                notified[r.name] = signature
            }
        }
    }
    writeFile file: stateFile, text: notified.collect { k, v -> "${k}=${v}" }.join('\n')
    return [notes: notes, fresh: fresh]
}

// Copy of "DB Integrity Scan\DBScan.sql" (IBD-1273 version, pg_maintain - no set_user_u
// escalation), embedded because this job has no checkout of the repo. Refresh it from that
// file when the scan script changes.
@NonCPS
def dbScanSql() {
    return """-- *******************************************************************************
-- * NAME: DBScan.sql
-- *
-- * PURPOSE: SQL script called by DBScan_body.cmd
-- *          Script looks for configured partitions that need to be scanned.
-- *          Default configuration is partitions are split in two groups scanned
-- *          every two weeks to accelerate DBScan.
-- *
-- *          Creates a dynamique sql script called partscan.sql and runs it.
-- *          Unfortuantely we cannot run a VACUUM through a function:
-- *          ERROR:  VACUUM cannot be executed from a function
-- *          Also cannot run vacuum inside a transction bloc (\\gexec):
-- *          ERROR:  VACUUM cannot run inside a transaction block
-- *
-- * CREATED: 09-SEP-16 by YC, version 6.0.0
-- *
-- * MODIFICATION HISTORY:
-- *      1. IBD-743 Use a less powerful user than the postgres superuser to run the scheduled tasks.
-- *         - Escalate to ibislx to be able to vacuum tables. Only table owner or superuser can vacuum tables.
-- *      2. 11-JUL-2025 by JML, version 6.0.0
-- *         IBD-1273 Grant pg_maintain (predefined role available in PG17) to ft_tasks instead of the ibis role to analyze and vacuum ibis tables
-- *         - No longer need escalate privs to set_user_u(postgres)
-- *         - pg_maintain available with PG17
-- *******************************************************************************
set statement_timeout=0;
SELECT current_schema() ibis_schema \\gset
SELECT current_date as today \\gset

--Save last_vacuum timestamp of partitions to be scanned.
--If last_vacuum does not change, it means an error has occured during scan.
CREATE TEMP TABLE vacuum_timestamps AS
SELECT sp.partname, COALESCE(psut.last_vacuum, current_date::TIMESTAMP) as last_vacuum FROM scan_partitions sp,
              pg_stat_user_tables psut
WHERE (sp.next_run_date < current_date OR (sp.next_run_date >= current_date AND EXTRACT(WEEK FROM sp.next_run_date) = EXTRACT(WEEK FROM now())))
  AND sp.partname = psut.relname
  AND status <>'I';

--Get selected scan type
SELECT
    EXISTS(SELECT 1 WHERE :'scantype' = 'full') as is_full,
    EXISTS(SELECT 1 WHERE :'scantype' = 'differential') as is_diff
\\gset

SELECT
    NOT EXISTS(SELECT 1 FROM scan_partitions WHERE (next_run_date < current_date OR (next_run_date >= current_date AND EXTRACT(WEEK FROM next_run_date) = EXTRACT(WEEK FROM now()))) AND status <> 'I') nothing2vacuum,
        EXISTS(SELECT 1 FROM scan_partitions WHERE (next_run_date < current_date OR (next_run_date >= current_date AND EXTRACT(WEEK FROM next_run_date) = EXTRACT(WEEK FROM now()))) AND status <> 'I') something2vacuum
\\gset

--If next_run_date <= current_date, vacuum partition(s)
\\if :something2vacuum
   \\pset tuples_only
   --Give WARNING if next_run_date of any partition is before current date.
   SELECT 'WARNING: Next_run_date before '||current_date||' for partition '||partname||'. It will be vacuumed, check configuration in scan_partitions table.' FROM scan_partitions WHERE next_run_date < current_date AND status <> 'I';
   \\a
   \\o :scanfile
   --Full scan requested.
   \\if :is_full
      \\echo :scantype scan requested.
   SELECT '\\echo Vacuuming '||partname||E'\\n'||
