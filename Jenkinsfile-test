// Regression step 1 - the DB Integrity Scan ("DB Integrity Scan\DBScan_body.cmd") without
// its pg_dump, run from here against one VM as dja (which has pg_maintain, so it can vacuum):
//   a. DBScan.sql, differential: vacuums the image/signature partitions due this week per
//      scan_partitions (and updates their status / next_run_date there, like the VM's own
//      scheduled scan would), then images_compressed and signatures_ext - plus the ibishits
//      tables where that schema exists - with disable_page_skipping, which reads every page
//      and so hits any corrupted block.
//   b. checkcon(true,true), as the scan runs it: stops with an error on any problem, with
//      the grace period for partition errors.
// Never the scan's haltDB.cmd: a failure is reported, the VM is not shut down.
// Returns [passed: bool, summary: text for the regression card].
def runDbIntegrityScan(String host) {
    env.DB_HOST = host
    def scanLog = "dbscan_output_${host}.txt"
    writeFile file: 'dbscan.sql', text: dbScanSql(), encoding: 'UTF-8'
    def scanRc
    withEnv(["DBSCAN_LOG=${scanLog}"]) {
        scanRc = bat(returnStatus: true, script: '''
            set PGPASSWORD=%DB_PASSWORD%
            psql -X -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -v scantype=differential -v scanfile=partscan.sql -f dbscan.sql > "%DBSCAN_LOG%" 2>&1
        ''')
    }
    archiveArtifacts artifacts: scanLog, allowEmptyArchive: true
    def scanOutput = readFile(scanLog).trim()
    // VACUUM VERBOSE is long - the full output is archived, the log gets the end of it.
    echo "DB Integrity Scan (differential) on ${host} - psql exit ${scanRc}, full output archived as ${scanLog}. Last lines:\n${scanOutput.readLines().takeRight(15).join('\n')}"
    // DBScan.sql only turns ON_ERROR_STOP on near its end, so a failed partition scan raises
    // an error without psql exiting non-zero - check for ERROR lines as well as the exit code.
    def scanErrors = scanOutput.readLines().findAll { it.contains('ERROR:') }.collect { it.trim() }
    if (scanRc != 0 || scanErrors) {
        def why = scanErrors ? scanErrors.take(3).join(' / ') : "psql exit ${scanRc}"
        echo "Regression FAILED on ${host}: DB Integrity Scan - ${why}"
        return [passed: false, summary: "DB Integrity Scan failed: ${why}"]
    }

    def ccRc = bat(returnStatus: true, script: '''
        set PGPASSWORD=%DB_PASSWORD%
        psql -X -q -h "%DB_HOST%" -p "%DB_PORT%" -U "%DB_USER%" -d "%DB_NAME%" -t -A -v ON_ERROR_STOP=1 -c "set statement_timeout=0;" -c "SELECT checkcon(true,true);" > regression_checkcon_output.txt 2>&1
    ''')
    def ccOutput = readFile('regression_checkcon_output.txt').trim()
    echo "Regression checkcon(true,true) on ${host}:\n${ccOutput}"
    if (ccRc != 0) {
        // It stopped on an error; its WARNING/ERROR lines say what (e.g. which constraints).
        def lines = ccOutput.readLines().findAll { it.contains('ERROR:') || it.contains('WARNING:') }.collect { it.trim() }
        def why = lines ? lines.take(4).join(' / ') : "psql exit ${ccRc}"
        echo "Regression FAILED on ${host}: checkcon(true,true) - ${why}"
        return [passed: false, summary: "checkcon failed: ${why}"]
    }
    if (!checkconPassed(ccOutput)) {
        def why = checkconFailingLines(ccOutput)
        echo "Regression FAILED on ${host}: checkcon(true,true) - ${why}"
        return [passed: false, summary: "checkcon failed: ${why}"]
    }
    echo "Regression passed on ${host}"
    return [passed: true, summary: 'passed']
}

// Which VM this job's DB Integrity Scan is on right now, if any - so a build that has to
// wait for this one can say why. One file per job (PGUP and its test job don't share it),
// in C:\Temp on the Jenkins host - outside the workspace, since a waiting build runs in a
// different one.
def scanStatusFile() {
    return "C:\\Temp\\${env.JOB_NAME}_dbscan_running.txt"
}

def markScanRunning(String host) {
    withEnv(["SCAN_STATUS_FILE=${scanStatusFile()}", "SCAN_HOST=${host}"]) {
        powershell(script: '''
            New-Item -ItemType Directory -Force -Path (Split-Path -Parent $env:SCAN_STATUS_FILE) | Out-Null
            Set-Content -LiteralPath $env:SCAN_STATUS_FILE -Encoding ASCII -Value ('{0}|{1}|{2}' -f $env:BUILD_NUMBER, $env:SCAN_HOST, (Get-Date -Format 'yyyy-MM-dd HH:mm'))
        ''')
    }
}

// Removes the status file - only if this build wrote it.
def clearScanStatus() {
    withEnv(["SCAN_STATUS_FILE=${scanStatusFile()}"]) {
        powershell(script: '''
            if (Test-Path -LiteralPath $env:SCAN_STATUS_FILE) {
                $line = Get-Content -LiteralPath $env:SCAN_STATUS_FILE -TotalCount 1
                if ("$line".StartsWith("$($env:BUILD_NUMBER)|")) {
                    Remove-Item -LiteralPath $env:SCAN_STATUS_FILE -Force -ErrorAction SilentlyContinue
                }
            }
        ''')
    }
}

// "DB Integrity Scan on <VM> (since <time>)" when build #number is in its scan, else null.
def scanStatusOf(int number) {
    def line = ''
    withEnv(["SCAN_STATUS_FILE=${scanStatusFile()}"]) {
        line = powershell(returnStdout: true, script: '''
            if (Test-Path -LiteralPath $env:SCAN_STATUS_FILE) { Get-Content -LiteralPath $env:SCAN_STATUS_FILE -TotalCount 1 }
        ''').trim()
    }
    def parts = line.split('\\|', -1)
    if (parts.size() == 3 && parts[0] == "${number}") {
        return "DB Integrity Scan on ${parts[1]} (since ${parts[2]})"
    }
    return null
}

