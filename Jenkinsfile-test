                            // reported version or the target changes; an unchanged mismatch isn't
                            // re-sent every run. When it does go out it lists every current mismatch.
                            def pgMismatches = results.findAll { r ->
                                r.detail.any { d -> d.label?.startsWith('PostgreSQL ') && d.passed == false }
