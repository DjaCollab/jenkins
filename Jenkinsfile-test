    postTeamsCard('teams_card_postponed.json', 'postponed notification')
}

// First stage of every build: never run alongside the previous build of this job (e.g. a
// DB Integrity Scan that ran past the next scheduled time). Waits for it, with one Teams
// card saying why, re-checking every PREVIOUS_RUN_POLL_MIN minutes for up to
// PREVIOUS_RUN_MAX_WAIT_MIN; still running after that -> this build stops without doing anything.
def waitForPreviousRun() {
    def previous = currentBuild.previousBuildInProgress
    if (previous == null) {
        return
    }
    def trigger = 'unknown'
    try {
        trigger = currentBuild.getBuildCauses().collect { it.shortDescription }.join(', ')
    } catch (Exception ignored) { }
    env.TRIGGER_CAUSE = trigger

    def what = scanStatusOf(previous.number) ?: 'upgrade in progress'
    echo "Build #${previous.number} is still running (${what}) - postponing this run until it finishes"
    sendPostponedNotification(previous.number, what)

    def pollMin    = env.PREVIOUS_RUN_POLL_MIN as int
    def maxWaitMin = env.PREVIOUS_RUN_MAX_WAIT_MIN as int
    def waitedMin  = 0
    while (currentBuild.previousBuildInProgress != null) {
        if (waitedMin >= maxWaitMin) {
            error("Build #${currentBuild.previousBuildInProgress.number} still running after ${maxWaitMin} min - not starting this run")
        }
        sleep(time: pollMin, unit: 'MINUTES')
        waitedMin += pollMin
        echo "Still waiting for build #${previous.number} (${waitedMin} min so far)"
    }
    echo "Build #${previous.number} finished after ${waitedMin} min of waiting - starting this run"
}

